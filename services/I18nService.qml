    // Lấy mã ngôn ngữ 2 ký tự từ locale hệ thống, vd "vi_VN" -> "vi"
    function currentLang() {
        var name = Qt.locale().name || "en"; // "vi_VN", "en_US", "nb_NO"...
        var code = name.split("_")[0].toLowerCase();
        if (code === "no") code = "nb"; // Na Uy: "no" và "nb" dùng chung bảng dịch
        return root.translations[code] ? code : "en";
    }

    // Lấy chuỗi đã dịch theo ngôn ngữ hệ thống.
    // params (tuỳ chọn): object thay thế placeholder dạng {key} trong chuỗi.
    function tr(key, params) {
        var lang = root.currentLang();
        var str = (root.translations[lang] && root.translations[lang][key]) || root.translations.en[key] || key;
        if (params) {
            for (var p in params) {
                str = str.split("{" + p + "}").join(params[p]);
            }
        }
        return str;
    }
}
