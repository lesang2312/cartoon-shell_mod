        {
            "id": "media",
            "shortcuts": [
                {
                    "action": "Volume Up +5%",
                    "args": [
                        "wpctl set-volume -l 2.0 @DEFAULT_AUDIO_SINK@ 5%+"
                    ],
                    "id": "vol_up",
                    "key": "XF86AudioRaiseVolume",
                    "locked": true,
                    "repeating": true,
                    "type": "exec_cmd"
                },
                {
                    "action": "Volume Down -5%",
                    "args": [
                        "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
                    ],
                    "id": "vol_down",
                    "key": "XF86AudioLowerVolume",
                    "locked": true,
                    "repeating": true,
                    "type": "exec_cmd"
                },
