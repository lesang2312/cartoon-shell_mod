        {
            "id": "brightness",
            "shortcuts": [
                {
                    "action": "Brightness Up +5%",
                    "args": [
                        "sh -c 'brightnessctl -e4 -n2 set 5%+; qs ipc --path ~/.config/quickshell/cartoon-shell call brightness set \"$(awk \"BEGIN {print $(brightnessctl g)/$(brightnessctl m)}\")\"'"
                    ],
                    "id": "bright_up",
                    "key": "XF86MonBrightnessUp",
                    "locked": true,
                    "repeating": true,
                    "type": "exec_cmd"
                },
                {
                    "action": "Brightness Down -5%",
                    "args": [
                        "sh -c 'brightnessctl -e4 -n2 set 5%-; qs ipc --path ~/.config/quickshell/cartoon-shell call brightness set \"$(awk \"BEGIN {print $(brightnessctl g)/$(brightnessctl m)}\")\"'"
                    ],
                    "id": "bright_down",
                    "key": "XF86MonBrightnessDown",
                    "locked": true,
                    "repeating": true,
                    "type": "exec_cmd"
                }
            ],
            "title": "🔆 Display Brightness"
        },
